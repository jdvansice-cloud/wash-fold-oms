{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "crons": [
    { "path": "/api/efactura/retry", "schedule": "*/15 * * * *" },
    { "path": "/api/notifications/pickup-reminders", "schedule": "0 14 * * *" }
  ]
}

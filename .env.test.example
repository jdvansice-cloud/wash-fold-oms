# Copy this to .env.test and fill in your values
# NEVER commit .env.test — it contains secrets

SUPABASE_URL=https://your-project.supabase.co

# New API keys (preferred). Generate in Supabase Dashboard → Settings → API keys.
#   - Publishable key (sb_publishable_…): safe for the browser, RLS-scoped.
#   - Secret key (sb_secret_…): server-only, bypasses RLS. NEVER expose to the client.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Legacy keys — still accepted as a fallback during migration; remove once the
# new keys above are set everywhere (local + Vercel).
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
